#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'banco'

module Banco
  options = CLI.parse
  options[:file] ||= FilePicker.pick

  Viewable.hello

  reader = Reader.new(options[:file], File.basename(options[:file], '.csv'),
                      skip_header: options[:skip_header])
  reader.read_in_csv_data
  report = Reporter.new(options[:file], File.basename(options[:file], '.csv'),
                        reader.all_from_csv)

  loop do
    report.menu
    answer = gets.chomp.downcase
    case answer
    when 'a' then print report.transactions_all
    when 'o' then print report.transactions_out
    when 'i' then print report.transactions_in
    when 'm' then print report.money_out_summary
    when 'n' then print report.money_in_summary
    when 'b' then print report.bottom_line
    when 'l'
      options[:file] = FilePicker.pick
      reader = Reader.new(options[:file], File.basename(options[:file], '.csv'),
                          skip_header: options[:skip_header])
      reader.read_in_csv_data
      report = Reporter.new(options[:file], File.basename(options[:file], '.csv'),
                            reader.all_from_csv)
    when 's' then report.save_summary_to_file
    when 't' then report.save_transactions_to_file
    when 'q' then break
    else report.menu
    end
  end
  Viewable.farewell
end
